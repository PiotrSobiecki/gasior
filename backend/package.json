{
  "name": "gasior-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:reset:dev": "node --env-file=.dev.vars --import tsx scripts/db-reset.ts",
    "db:migrate:dev": "node --env-file=.dev.vars node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node --env-file=.prod.vars node_modules/drizzle-kit/bin.cjs migrate",
    "db:push:dev": "node --env-file=.dev.vars node_modules/drizzle-kit/bin.cjs push",
    "db:studio:dev": "node --env-file=.dev.vars node_modules/drizzle-kit/bin.cjs studio",
    "db:studio:prod": "node --env-file=.prod.vars node_modules/drizzle-kit/bin.cjs studio",
    "db:curate": "node --env-file=.dev.vars --import tsx scripts/curate.ts",
    "db:demo": "node --env-file=.dev.vars --import tsx scripts/set-demo.ts",
    "db:demo:prod": "node --env-file=.prod.vars --import tsx scripts/set-demo.ts",
    "db:seed": "node --env-file=.dev.vars --import tsx scripts/seed-recipes.ts",
    "db:seed:prod": "node --env-file=.prod.vars --import tsx scripts/seed-recipes.ts",
    "db:dedupe": "node --env-file=.dev.vars --import tsx scripts/dedupe-recipes.ts",
    "db:dedupe:apply": "node --env-file=.dev.vars --import tsx scripts/dedupe-recipes.ts --apply",
    "db:dedupe:prod": "node --env-file=.prod.vars --import tsx scripts/dedupe-recipes.ts",
    "db:dedupe:prod:apply": "node --env-file=.prod.vars --import tsx scripts/dedupe-recipes.ts --apply",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@types/node": "^22.19.19",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.94.0"
  }
}
